SUPABASE_URL=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=
# OpenRouter (optional) - only used by the chatbot, which calls NVIDIA Nemotron 3 Ultra via
# OpenRouter's OpenAI-compatible endpoint instead of Gemini (see agents/_llm.py::get_openrouter_llm
# and PROJECT_CONTEXT.md). Get a key at https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
CORS_ORIGINS=http://localhost:5173

# Gmail sync (optional) - from a Google Cloud OAuth client, see PROJECT_CONTEXT.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback
FRONTEND_URL=http://localhost:5173

# LangSmith tracing (optional, free tier) - sign up at https://smith.langchain.com, create an
# API key, then set these two to trace every agent's input/output automatically (see
# PROJECT_CONTEXT.md). Leave LANGCHAIN_TRACING_V2 as false to disable.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
